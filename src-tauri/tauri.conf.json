{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipbox",
  "version": "0.2.24",
  "identifier": "com.clipbox.tauri",
  "build": {
    "frontendDist": "../dist-tauri",
    "beforeBuildCommand": "npm run tauri:frontend",
    "beforeDevCommand": "npm run tauri:frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
