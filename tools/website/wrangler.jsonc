// Cloudflare Worker (static assets only) that serves copyboxx.com from dist-website/.
// `npm run website:deploy` uses this file; build dist-website/ first (see README.md).
{
  "name": "copyboxx-site",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist-website",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "copyboxx.com", "custom_domain": true },
    { "pattern": "www.copyboxx.com", "custom_domain": true }
  ]
}
