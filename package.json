{
  "name": "clipbox-local-vault",
  "version": "0.2.24",
  "description": "本地加密的秘密与话术复制盒",
  "author": "Clipbox",
  "private": true,
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && node desktop/prepare-standalone.mjs && electron-builder --mac dir --arm64",
    "desktop:pack:mac": "npm run build && node desktop/prepare-standalone.mjs && electron-builder --mac dir --arm64",
    "desktop:pack:win": "npm run build && node desktop/prepare-standalone.mjs && electron-builder --win nsis --x64",
    "db:generate": "drizzle-kit generate",
    "test:desktop-idle": "node --test tests/desktop-idle.integration.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.126.0"
  },
  "type": "module",
  "build": {
    "appId": "com.clipbox.desktop",
    "productName": "Clipbox",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/desktop-standalone",
        "to": "standalone"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "desktop/assets/Clipbox.icns",
      "identity": null,
      "target": [
        "dir"
      ]
    },
    "win": {
      "icon": "desktop/assets/Clipbox.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Clipbox",
      "artifactName": "Clipbox-Setup-${version}-${arch}.${ext}"
    }
  }
}
