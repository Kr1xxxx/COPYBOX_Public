{
  "name": "clipbox-local-vault",
  "version": "0.2.24",
  "description": "本地加密的秘密与话术复制盒",
  "author": "Clipbox",
  "private": true,
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && node desktop/prepare-standalone.mjs && electron-builder --mac dir --arm64",
    "desktop:pack:win": "npm run build && node desktop/prepare-standalone.mjs && electron-builder --win nsis --x64",
    "db:generate": "drizzle-kit generate",
    "test:desktop-idle": "node --test tests/desktop-idle.integration.mjs",
    "test:e2e": "npm run build && playwright test",
    "preview:build": "node tools/preview/build.mjs",
    "preview:serve": "node tools/preview/serve.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.2",
    "motion": "13.4.0",
    "pinyin-pro": "3.29.4",
    "papaparse": "5.7.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "read-excel-file": "9.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "write-excel-file": "4.1.1"
  },
  "type": "module",
  "build": {
    "appId": "com.clipbox.desktop",
    "productName": "Clipbox",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/desktop-standalone",
        "to": "standalone"
      }
    ],
    "win": {
      "icon": "desktop/assets/Clipbox.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "desktop/assets/Clipbox.icns",
      "identity": null,
      "target": [
        "dir"
      ]
    }
  }
}
